{
  "name": "a1-booking",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests --exclude 'tests/browser/**'",
    "test:browser": "vitest run tests/browser",
    "site": "tsx src/site/server.ts",
    "runs": "tsx src/run.ts",
    "report": "tsx src/report.ts",
    "case": "tsx src/run.ts && tsx src/report.ts"
  },
  "dependencies": {
    "@aec/llm": "workspace:*"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
