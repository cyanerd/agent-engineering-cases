{
  "name": "b1-phone-orgs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit --passWithNoTests",
    "build:spi": "cd keycloak-sms && mvn -q -B package",
    "up": "tsx scripts/up.ts",
    "down": "docker compose down -v",
    "stand": "vitest run tests/stand --no-file-parallelism",
    "case": "pnpm run build:spi && tsx scripts/up.ts && vitest run tests/stand --no-file-parallelism"
  },
  "dependencies": { "jose": "^5.9.0", "pg": "^8.13.0" },
  "devDependencies": { "@types/pg": "^8.11.0" }
}
